# ─── Base de données ───────────────────────────────────────
# PostgreSQL — identifiants à ne JAMAIS committer
DATABASE_URL=postgresql://user:password@localhost:5432/haivoly
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
# Journalisation SQL (dev uniquement)
TYPEORM_LOGGING=false
# Très déconseillé : synchronisation automatique du schéma (jamais en prod)
DB_SYNCHRONIZE=false

# ─── Authentification ──────────────────────────────────────
JWT_SECRET=change-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ─── Serveur ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Liste d'origines séparées par des virgules (vide = toutes)
CORS_ORIGINS=

# ─── Emails (mot de passe oublié) ──────────────────────────
APP_NAME=Haivoly
FRONTEND_URL=exp://haivoly
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
